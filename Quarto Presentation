```{r}
#| include: false
library(tidyverse)
library(MASS)
library(scales)

accident <- read_csv("FARS2024NationalCSV/accident.csv")
vehicle <- read_csv("FARS2024NationalCSV/vehicle.csv")
person <- read_csv("FARS2024NationalCSV/person.csv")

accident_small <- accident |>
  dplyr::select(
    ST_CASE, STATE, STATENAME, FATALS, DAY_WEEK, DAY_WEEKNAME,
    HOUR, HOURNAME, RUR_URB, RUR_URBNAME, LGT_COND, LGT_CONDNAME,
    WEATHER, WEATHERNAME, FUNC_SYS, FUNC_SYSNAME
  )

vehicle_small <- vehicle |>
  dplyr::select(
    ST_CASE, VEH_NO, BODY_TYP, BODY_TYPNAME, TRAV_SP, TRAV_SPNAME,
    ROLLOVER, ROLLOVERNAME, SPEEDREL, SPEEDRELNAME, DR_DRINK,
    DR_DRINKNAME, DEATHS
  )

person_small <- person |>
  dplyr::select(
    ST_CASE, VEH_NO, PER_NO, PER_TYPNAME, AGE, AGENAME, SEX,
    SEXNAME, DRINKING, DRINKINGNAME
  )

driver_small <- person_small |>
  filter(PER_TYPNAME == "Driver of a Motor Vehicle In-Transport")

vehicle_driver <- vehicle_small |>
  left_join(driver_small, by = c("ST_CASE", "VEH_NO"))

accident_weekend <- accident_small |>
  mutate(
    weekend = if_else(
      DAY_WEEKNAME %in% c("Saturday", "Sunday"),
      "Weekend",
      "Weekday"
    )
  )

accident_daynight <- accident_small |>
  mutate(
    day_night = if_else(LGT_CONDNAME == "Daylight", "Day", "Night")
  )

vehicle_plot <- vehicle_driver |>
  left_join(
    accident_weekend |> dplyr::select(ST_CASE, weekend),
    by = "ST_CASE"
  ) |>
  mutate(
    vehicle_type = case_when(
      BODY_TYPNAME == "4-door sedan, hardtop" ~ "Sedan",
      BODY_TYPNAME == "Light Pickup" ~ "Pickup",
      BODY_TYPNAME == 'Compact Utility (Utility Vehicle Categories "Small" and "Midsize")' ~ "Compact SUV",
      BODY_TYPNAME == 'Large utility (ANSI D16.1 Utility Vehicle Categories and "Full Size" and "Large")' ~ "Large SUV",
      BODY_TYPNAME == "Two Wheel Motorcycle (excluding motor scooters)" ~ "Motorcycle",
      BODY_TYPNAME == "Truck-tractor (Cab only, or with any number of trailing unit; any weight)" ~ "Truck Tractor",
      TRUE ~ BODY_TYPNAME
    )
  )

top_vehicle <- vehicle_plot |>
  count(vehicle_type, sort = TRUE) |>
  slice_head(n = 6) |>
  pull(vehicle_type)

driver_daynight <- driver_small |>
  left_join(
    accident_daynight |> dplyr::select(ST_CASE, day_night),
    by = "ST_CASE"
  ) |>
  mutate(
    alcohol_involvement = case_when(
      DRINKINGNAME == "Yes (Alcohol Involved)" ~ "Alcohol Involved",
      DRINKINGNAME == "No (Alcohol Not Involved)" ~ "No Alcohol Involved",
      TRUE ~ NA_character_
    )
  )
```

## Project overview
**Goal**: Examine patterns and predictors of fatal motor vehicle crashes across the United States.

**Data**: 2024 Fatality Analysis Reporting System (FARS), maintained by the National Highway Traffic Safety Administration (NHTSA).

**Files used**: accident-level, vehicle-level, and person-level data.

**Main factors**: geographic setting, time, weather and lighting, vehicle characteristics, and driver characteristics.

## Data and preparation
::: {.columns}
::: {.column width="50%"}

**Accident file:** one row per fatal crash

**Vehicle file:** one row per vehicle involved

**Person file:** one row per person involved

Data files were joined using ST_CASE
:::

::: {.column width="50%"}
**Variables Created**
Weekend: Saturday/Sunday vs. Monday-Friday

Day/Night: Daylight vs. all other lighting conditions

- Filtered to drivers for driver-level analyses

- Joined vehicle and driver information for vehicle-level EDA
:::
:::

## Research questions
1. Rural vs. urban: Do rural fatal crashes involve more fatalities per crash than urban crashes?

2. Weekend vs. weekday: Are fatal crashes more common on weekends, and do timing and vehicle types differ?

3. Weekend/night patterns: Which crash, vehicle, driver, and state characteristics are associated with weekend and nighttime fatal crashes?

## Research Question 1
Do rural fatal crashes involve more fatalities per crash than urban crashes?

**Outcome:** number of fatalities per crash (FATALS)

**Main predictor:** rural/urban location (RUR_URB)

**Additional factors:** lighting, weather, road class, travel speed, rollover, speed-related status, alcohol involvement, and driver age

**Methods:** descriptive plots, two-sample t-test, and count-regression exploration

