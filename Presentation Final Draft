    "Hour of day and weekend status"
  ),
  `Key result` = c(
    paste0(
      "&chi;<sup>2</sup>(1) = ",
      round(unname(weekend_chi$statistic), 2),
      ", <i>p</i> &lt; .001"
    ),
    paste0(
      "&chi;<sup>2</sup>(5) = ",
      round(unname(vehicle_chi$statistic), 2),
      ", <i>p</i> &lt; .001"
    ),
    paste0(
      "2 a.m. odds ratio = ",
      round(hour_2am_or, 2)
    )
  ),
  Interpretation = c(
    "Fatal crashes occurred at a significantly higher rate per day on weekends.",
    "The distribution of vehicle types differed significantly between weekend and weekday crashes.",
    "At 2 a.m., fatal crashes had higher odds of occurring on weekends than at midnight."
  )
)

knitr::kable(
  rq2_results,
  format = "html",
  escape = FALSE,
  align = c("l", "c", "l"),
  table.attr = 'style="font-size: 22px; width: 100%;"'
)
```

**Takeaway:** Weekend fatal crashes occurred more frequently per day and
were more concentrated during late-night and early-morning hours.

